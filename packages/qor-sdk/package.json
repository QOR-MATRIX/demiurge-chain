{
  "name": "@demiurge/qor-sdk",
  "version": "1.0.0",
  "description": "QOR Identity SDK for Demiurge-Cloud - Decentralized identity with human-readable handles",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "demiurge",
    "qor",
    "identity",
    "did",
    "authentication",
    "web3",
    "blockchain"
  ],
  "author": "Demiurge-Cloud",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ALaustrup/demiurge-cloud.git",
    "directory": "packages/qor-sdk"
  },
  "homepage": "https://qorsync.dev",
  "bugs": {
    "url": "https://github.com/ALaustrup/demiurge-cloud/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  }
}
