{
  "name": "@demiurge/agent-foundry",
  "version": "1.0.0",
  "description": "Agent Foundry SDK - Create autonomous AI agents as First-Class Citizens on the Demiurge-Cloud",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./providers": {
      "import": "./dist/providers/index.mjs",
      "require": "./dist/providers/index.js",
      "types": "./dist/providers/index.d.ts"
    },
    "./tools": {
      "import": "./dist/tools/index.mjs",
      "require": "./dist/tools/index.js",
      "types": "./dist/tools/index.d.ts"
    },
    "./memory": {
      "import": "./dist/memory/index.mjs",
      "require": "./dist/memory/index.js",
      "types": "./dist/memory/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/providers/index.ts src/tools/index.ts src/memory/index.ts --format cjs,esm --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "demiurge",
    "blockchain",
    "ai",
    "agents",
    "llm",
    "autonomous",
    "sovereign",
    "did",
    "openai",
    "gemini",
    "web3"
  ],
  "author": "Demiurge-Cloud",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ALaustrup/demiurge-cloud.git",
    "directory": "packages/agent-foundry"
  },
  "homepage": "https://qorsync.dev",
  "bugs": {
    "url": "https://github.com/ALaustrup/demiurge-cloud/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "openai": "^4.0.0",
    "@google/generative-ai": "^0.21.0",
    "axios": "^1.6.0",
    "eventemitter3": "^5.0.1",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "peerDependencies": {
    "@demiurge/qor-sdk": ">=1.0.0",
    "@demiurge/drc369-sdk": ">=1.0.0",
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "@demiurge/qor-sdk": {
      "optional": true
    },
    "@demiurge/drc369-sdk": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  }
}
