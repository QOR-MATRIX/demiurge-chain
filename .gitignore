# Demiurge-Blockchain .gitignore

# Substrate/Rust
target/
**/*.rs.bk
*.pdb

# Cargo.lock IS committed. This workspace builds binaries (demiurge-node,
# qor-auth), not a published library, so the lockfile must be tracked for
# reproducible builds. Without it a fresh clone resolves the newest crate
# versions, which the pinned toolchain in rust-toolchain.toml cannot compile.

# Build artifacts
/data/
build/
dist/
*.wasm
*.compact.wasm

# Node.js / JavaScript
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
# The launcher's is tracked: CI installs it with `npm ci`, so it tests exactly the
# versions a developer has, and every dependency in package.json is a range.
!tools/qor-launcher/package-lock.json
# ARQADE's too, for the same reason: its CI job runs `npm ci` (ADR-069).
!products/arqade/package-lock.json
# The arcade's build/ is source, not output: the Sites Vite plugin vite.config.ts imports (MIT, licence beside it).
!products/arqade/build/
.pnpm-debug.log*
.next/
.turbo/
dist/
*.tsbuildinfo

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
ENV/
env/

# Unreal Engine 5
Binaries/
DerivedDataCache/
Intermediate/
Saved/
*.VC.db
*.opensdf
*.opendb
*.sdf
*.sln
*.suo
*.xcodeproj
*.xcworkspace

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Logs
*.log
logs/

# Environment
.env
.env.local
.env.*.local
.env.production
secrets/
*.key
*.pem

# Database
*.db
*.sqlite
*.sqlite3

# Blockchain specific
chains/
keystore/
.substrate/
polkadot-parachain

# Docker
docker-compose.override.yml

# OS
Thumbs.db
.DS_Store
*.tmp
.tmp.driveupload/

# UE5 Source (large, not tracked)
ue5-source/
ue5_*.log

# Server-specific backups
/tmp/*-backup-*

# Tools - Other folder (user-added helpful resources, not tracked)
tools/Other/

# Production secrets (never commit)
config/production/.secrets

# Production secrets - NEVER commit these
config/production/secrets/postgres_password
config/production/secrets/jwt_secret
config/production/secrets/session_secret

# Validator keys - NEVER commit these
*.key
!*.key.example
tools/spline-mcp-server/


