{
  "name": "@demiurge/drc369-sdk",
  "version": "1.0.0",
  "description": "TypeScript SDK for DRC-369 Evolving NFTs with CVP Protection - Dynamic NFTs that grow with your players",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./react": {
      "import": "./dist/react/index.mjs",
      "require": "./dist/react/index.js",
      "types": "./dist/react/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/react/index.tsx --format cjs,esm --clean",
    "dev": "tsup src/index.ts src/react/index.ts --format cjs,esm --dts --watch",
    "clean": "rm -rf dist",
    "test": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "drc369",
    "nft",
    "blockchain",
    "demiurge",
    "cvp",
    "evolving-nfts",
    "dynamic-nft",
    "gaming",
    "web3",
    "react"
  ],
  "author": "Demiurge-Cloud",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ALaustrup/demiurge-cloud.git",
    "directory": "packages/drc369-sdk"
  },
  "homepage": "https://qorsync.dev",
  "bugs": {
    "url": "https://github.com/ALaustrup/demiurge-cloud/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "eventemitter3": "^5.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
