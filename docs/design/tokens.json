{
  "about": "The one source of Demiurge's look (ADR-108): obsidian and gilt, ember the one colour of action. Every surface takes these values from files docs/design/tokens.mjs generates, and never writes them by hand. Edit here, run `node docs/design/tokens.mjs`, and commit what it writes. `--check` fails when a generated file is stale, a copied font differs, or a text colour reads under the contrast floor on any background.",
  "color": {
    "void": "#06070a",
    "base": "#0b0e14",
    "well": "#0e121a",
    "surface": "#131821",
    "raised": "#1b212d",
    "edge": "#2a3140",
    "edgeSoft": "#1f2530",
    "ink": "#f3ede1",
    "inkBody": "#d6d1c6",
    "inkMuted": "#9ba2ad",
    "inkFaint": "#868f9d",
    "accent": "#ff6a00",
    "accentBright": "#ff9142",
    "accentDim": "#b44a00",
    "onAccent": "#06070a",
    "gilt": "#c9a45c",
    "giltBright": "#ead39a",
    "giltDim": "#7a6236",
    "ok": "#22c55e",
    "warn": "#e6a817",
    "bad": "#d57889"
  },
  "contrast": {
    "minimum": 4.5,
    "backgrounds": ["void", "base", "well", "surface", "raised"],
    "text": ["ink", "inkBody", "inkMuted", "inkFaint", "accent", "accentBright", "gilt", "giltBright", "ok", "warn", "bad"],
    "onFill": { "accent": "onAccent", "accentBright": "onAccent", "gilt": "onAccent", "giltBright": "onAccent" }
  },
  "font": {
    "display": { "family": "Cinzel", "fallback": "\"Trajan Pro\", \"Times New Roman\", Georgia, serif" },
    "interface": { "family": "Barlow Semi Condensed", "fallback": "\"Arial Narrow\", \"Segoe UI\", system-ui, sans-serif" },
    "body": { "family": "Barlow", "fallback": "\"Segoe UI\", system-ui, -apple-system, sans-serif" },
    "mono": { "family": "IBM Plex Mono", "fallback": "ui-monospace, \"Cascadia Mono\", Consolas, monospace" }
  },
  "size": { "micro": 10, "caption": 11, "ui": 12, "body": 13, "title": 15, "heading": 18, "display": 24, "figure": 38 },
  "tracking": { "heading": "0.06em", "label": "0.1em", "eyebrow": "0.18em" },
  "radius": { "control": 8, "panel": 12 },
  "motion": { "ease": "cubic-bezier(0.16, 1, 0.3, 1)", "quick": 150, "standard": 260, "enter": 420, "sheen": 760 },
  "focus": { "width": 2, "halo": 5, "color": "accentBright" }
}
